{
  "name": "bg-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP (stdio) server for Banco General's Zona Segura",
  "type": "module",
  "bin": {
    "bg-mcp": "dist/cli/bin.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "login": "node dist/cli/bin.js login",
    "test": "node --test test-dist/test/*.test.js",
    "pretest": "tsc -p tsconfig.test.json",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "banco-general",
    "banking",
    "read-only"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.13.6",
    "playwright": "^1.58.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
